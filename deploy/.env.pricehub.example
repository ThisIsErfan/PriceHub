# PriceHub prod .env (example) — the deploy workflow WRITES the real one from
# GitHub secrets/vars on the server. Copy to `.env` only for a manual deploy.

# Image (owner lowercased). The deploy workflow computes IMAGE_PREFIX for you.
IMAGE_PREFIX=ghcr.io/thisiserfan/pricehub
IMAGE_TAG=latest

# Database — the SELECT-only partner role. PARTNER_DB_* MUST match the values in
# pricing-copilot's crawlers/.env (and the password set by R001__grants.sql).
CRAWLER_DB_NAME=pricing_db
PARTNER_DB_USER=partner_api_usr
PARTNER_DB_PASSWORD=change-me-must-match-crawlers-env

# Redis
PRICEHUB_REDIS_PASSWORD=change-me-strong-random

# App
PARTNER_CORS_ORIGINS=
DEFAULT_RATE_LIMIT_PER_SEC=5
DEFAULT_RATE_LIMIT_PER_MIN=120
